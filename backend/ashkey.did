type AccountView = record {
  now : nat64;
  vault_until : nat64;
  used : nat64;
  quota : nat64;
  vault_active : bool;
  heritage_active : bool;
  vault_tier : nat8;
  exists : bool;
  heritage_until : nat64;
  // When files will be destroyed if not renewed (only once the plan expired).
  vault_destroy_at : opt nat64;
};
type FileView = record {
  id : nat64;
  created : nat64;
  has_thumb : bool;
  meta : blob;
  size : nat64;
  complete : bool;
  chunks : nat32;
};
type HeirIn = record { claim_hash : blob; wrapped_key : blob };
type HeirView = record {
  opens_left : nat32;
  size : nat64;
  deadline : nat64;
  released : bool;
  chunks : nat32;
};
type Info = record {
  // Agreed XMR rate in US cents, and when it was last confirmed (ns).
  xmr_usd_cents : opt nat64;
  // Current XMR equivalents (piconero) of the USD prices; 0 when no fresh rate.
  vault_prices : vec nat64;
  max_heirs : nat32;
  xmr_usd_at : opt nat64;
  released_keep_sec : nat64;
  quote_valid_sec : nat64;
  max_chunk : nat64;
  max_switches : nat32;
  usd_heritage_price : nat64;
  heritage_grace_sec : nat64;
  network : text;
  tier_bytes : vec nat64;
  version : text;
  payments_ready : bool;
  heritage_context : blob;
  nodes : vec text;
  heritage_public_key : opt blob;
  key_name : text;
  min_confirmations : nat32;
  vault_grace_sec : nat64;
  paused : bool;
  // Yearly prices in US cents.
  usd_vault_prices : vec nat64;
  heritage_max_bytes : nat64;
  heritage_price : nat64;
};
type Opened = record {
  encrypted_key : blob;
  ibe_id : blob;
  wrapped_key : blob;
};
type OrderView = record {
  id : nat64;
  txs : vec text;
  created : nat64;
  quote_until : opt nat64;
  paid : bool;
  usd_cents : opt nat64;
  address : text;
  amount : nat64;
  received : nat64;
  years : nat8;
  product : Product;
};
type PaymentStatus = variant {
  // Transaction not known to the nodes (yet). Wait a minute and retry.
  NotFound;
  // Mined at `height`; needs `needed` confirmations in total.
  Waiting : record { height : nat64; needed : nat32 };
  // Credited. `order.paid` tells whether the order is now fully paid.
  Credited : record { order : OrderView; amount : nat64 };
  // Seen in the mempool, not mined yet.
  InPool;
};
type Product = variant {
  // Vault tier 1, 2 or 3 (see `TIER_BYTES`).
  Vault : nat8;
  Heritage;
};
type Result = variant { Ok; Err : text };
type Result_1 = variant { Ok : record { opt nat64; vec nat64 }; Err : text };
type Result_10 = variant { Ok : PaymentStatus; Err : text };
type Result_2 = variant { Ok : text; Err : text };
type Result_3 = variant { Ok : Stats; Err : text };
type Result_4 = variant { Ok : nat32; Err : text };
type Result_5 = variant { Ok : OrderView; Err : text };
type Result_6 = variant { Ok : nat64; Err : text };
type Result_7 = variant { Ok : blob; Err : text };
type Result_8 = variant { Ok : HeirView; Err : text };
type Result_9 = variant { Ok : Opened; Err : text };
type Stats = record {
  files : nat64;
  switches : nat64;
  orders : nat64;
  vault_bytes : nat64;
  cycles : nat;
  accounts : nat64;
  paid_orders : nat64;
  received_pico : nat64;
};
type SwitchIn = record {
  heirs : vec HeirIn;
  meta : blob;
  size : nat64;
  interval_sec : nat64;
  ibe_id : blob;
  chunks : nat32;
};
type SwitchView = record {
  id : nat64;
  created : nat64;
  meta : blob;
  size : nat64;
  last_check_in : nat64;
  deadline : nat64;
  released : bool;
  complete : bool;
  heir_opens : vec nat32;
  interval_sec : nat64;
  destroy_at : nat64;
  chunks : nat32;
};
service : () -> {
  // Gives a plan without payment (support cases, tests). It can only add time
  // to an account; it cannot read or move anything.
  admin_grant : (principal, Product, nat8) -> (Result);
  // Reads the price sources now. Returns the agreed rate (if any) and the raw readings.
  admin_refresh_price : () -> (Result_1);
  // Lowers the minimum switch interval (tests only; never below 60 s). `None` restores 7 days.
  admin_set_min_interval : (opt nat64) -> (Result);
  admin_set_nodes : (vec text) -> (Result);
  admin_set_params : (nat32, text, bool) -> (Result);
  // Yearly prices in US cents (vault tiers 1..3, heritage). Paid plans are not affected.
  admin_set_usd_prices : (vec nat64, nat64) -> (Result);
  // Sets the service wallet. Returns its main address so the operator can
  // check it matches the wallet they control.
  admin_set_wallet : (text, text, text) -> (Result_2);
  // Emergency fallback when the feeds are down: sets the rate by hand (US cents per XMR).
  admin_set_xmr_rate : (nat64) -> (Result);
  admin_stats : () -> (Result_3) query;
  // "I'm still here": pushes back every armed switch of this account.
  // Free, and works even if the plan has lapsed (it cannot push past the
  // payment grace deadline, though).
  check_in : () -> (Result_4);
  create_order : (Product, nat8) -> (Result_5);
  file_begin : (blob, nat64, nat32) -> (Result_6);
  file_chunk : (nat64, nat32) -> (Result_7) query;
  file_commit : (nat64) -> (Result);
  file_delete : (nat64) -> (Result);
  file_list : () -> (vec FileView) query;
  file_put : (nat64, nat32, blob) -> (Result);
  file_set_meta : (nat64, blob) -> (Result);
  // Stores (or replaces) the encrypted thumbnail of an image.
  file_set_thumb : (nat64, blob) -> (Result);
  file_thumb : (nat64) -> (Result_7) query;
  get_info : () -> (Info) query;
  heir_chunk : (nat64, blob, nat32) -> (Result_7) query;
  heir_lookup : (nat64, blob) -> (Result_8) query;
  heir_open : (nat64, blob, blob) -> (Result_9);
  // Fetches and caches this canister's vetKD public key for heritage.
  // Browsers also derive it offline from the IC master key and compare.
  heritage_public_key : () -> (Result_7);
  me : () -> (AccountView) query;
  my_orders : () -> (vec OrderView) query;
  my_switches : () -> (vec SwitchView) query;
  submit_payment : (nat64, text) -> (Result_10);
  switch_commit : (nat64) -> (Result);
  switch_create : (SwitchIn) -> (Result_6);
  switch_delete : (nat64) -> (Result);
  switch_put : (nat64, nat32, blob) -> (Result);
  switch_set_interval : (nat64, nat64) -> (Result);
}